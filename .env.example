# ==============================================================================
# NutriSun Frontend - Environment Configuration Template (.env.example)
# ==============================================================================
# DO NOT commit actual credentials or secret files (.env, .env.local) to source control.
# Copy this file to .env.local for local development.
# Configure these variables in your Vercel Project Settings > Environment Variables.

# ------------------------------------------------------------------------------
# 1. Backend Service Routing (Vercel & Production)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL:
# The live Render backend URL for API requests.
NEXT_PUBLIC_API_URL=https://nutrisun-backend-hirj.onrender.com

# INTERNAL_BACKEND_URL:
# The root HTTPS URL of your deployed Go backend service on Render.
# Next.js rewrites use this URL to proxy both '/api/*' and '/uploads/*' on the same origin.
# Value for Vercel production: https://nutrisun-backend-hirj.onrender.com
INTERNAL_BACKEND_URL=https://nutrisun-backend-hirj.onrender.com

# NEXT_PUBLIC_API_BASE_URL:
# Client-side API endpoint for browser requests.
# Set to '/api' (recommended) to route requests via Next.js same-origin rewrites,
# avoiding CORS restrictions and passing authorization headers automatically.
NEXT_PUBLIC_API_BASE_URL=/api

# ------------------------------------------------------------------------------
# 2. Local Development Overrides (Uncomment in your local .env.local if needed)
# ------------------------------------------------------------------------------
# INTERNAL_BACKEND_URL=http://localhost:8080
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# ------------------------------------------------------------------------------
# 3. Business Payment UPI & QR Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_PAYEE_NAME="Syed Kaleel Awn Mohamed Ismail"
NEXT_PUBLIC_UPI_ID="nutrisun@kvb"
NEXT_PUBLIC_QR_ASSET_PATH="/KVB_QR.png"
NEXT_PUBLIC_PAYMENT_INSTRUCTION="Scan this QR using any UPI app, enter the exact amount shown, and upload your payment screenshot for admin verification."
